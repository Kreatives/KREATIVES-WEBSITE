# KREATIVES — environment variabelen (voorbeeld). Kopieer naar .env.local en vul in.

# Supabase (publiek)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — nodig voor de DAGELIJKSE cron (/api/blog-pipeline),
# die zonder ingelogde gebruiker draait. Te vinden in Supabase → Project Settings → API.
# NOOIT naar de client sturen. De "Genereer nu"-knop in /admin werkt ook zonder deze key.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — schrijft de blogartikelen (model claude-opus-4-8).
ANTHROPIC_API_KEY=

# Beveiligt /api/blog-pipeline. Vercel-cron stuurt automatisch "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Magnific — AI-beeldgeneratie (hoofdafbeelding, .webp) via het Mystic-model.
# Maak een API-key aan in Magnific → Settings → API Keys (Business/Enterprise-plan).
# De "Genereer AI-foto"-knop in /admin gebruikt deze key server-side.
MAGNIFIC_API_KEY=
# Optioneel — andere Mystic-instellingen (defaults: realism / automatic / 2k).
# model: realism | fluid | zen | flexible | super_real | editorial_portraits
MAGNIFIC_MODEL=
# engine: automatic | magnific_illusio | magnific_sharpy | magnific_sparkle
MAGNIFIC_ENGINE=
# resolution: 1k | 2k | 4k
MAGNIFIC_RESOLUTION=

# Higgsfield — vorige beeldprovider (nu ongebruikt; lib/pipeline/image.ts).
# Alleen nodig als je terugschakelt naar Higgsfield i.p.v. Magnific.
HF_CREDENTIALS=
HIGGSFIELD_IMAGE_ENDPOINT=

# Optioneel — Google Search Console API voor echte query-data in de zoekwoord-gap-analyse.
# Zonder deze waarden valt de bot terug op dekking t.o.v. bestaande titels.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=

# Hostinger SMTP (contactformulieren)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
